{
  "manifest_version": 3,
  "name": "DeepSeek Code Extractor",
  "version": "1.1.0",
  "description": "Extract fenced code blocks from chat.deepseek.com with filename/path detection, optional per-file save dialog, and ZIP download.",
  "permissions": ["activeTab", "downloads"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepSeek Code Extractor"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }        
}
